# Untuk MOD PELAYAN sahaja. App APK biasa tidak perlukan fail ini — masukkan kunci
# dalam skrin ⚙️ Tetapan di telefon.
# Salin fail ini ke `.env` dan isi nilai anda. Fail .env TIDAK akan di-commit.
# Pembolehubah tanpa awalan EXPO_PUBLIC_ hanya dibaca oleh pelayan (API routes).

# --- Wajib untuk komik sebenar (tanpa ini app berjalan dalam mod demo) ---
ANTHROPIC_API_KEY=

# --- Pilihan: penjana gambar OpenAI ---
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium

# --- Pilihan: Pollinations (percuma; kunci hanya jika anda ada akaun) ---
# POLLINATIONS_API_KEY=
# POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt/
# POLLINATIONS_MODEL=flux

# --- Pilihan: model Claude (lalai: claude-opus-5-5) ---
# CLAUDE_MODEL=claude-opus-5-5

# --- Pilihan: paksa mod demo walaupun ada kunci ---
# DEMO_MODE=1

# --- Pilihan: lindungi pelayan awam daripada digunakan orang lain ---
# APP_ACCESS_TOKEN=rahsia-panjang-anda
# EXPO_PUBLIC_APP_TOKEN=rahsia-panjang-anda

# --- Untuk build telefon (production): alamat pelayan yang telah di-deploy ---
# EXPO_PUBLIC_API_URL=https://komik-lab.expo.app
